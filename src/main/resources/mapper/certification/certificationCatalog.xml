<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.practice.logincrud.certification.catalog.CertificationCatalogMapper">

    <select id="findByName" resultType="com.practice.logincrud.certification.catalog.CertificationCatalogDto">
        SELECT id, name, created_at
        FROM certification_catalog
        WHERE name = #{name}
    </select>

    <select id="findById" resultType="com.practice.logincrud.certification.catalog.CertificationCatalogDto">
        SELECT id, name, created_at
        FROM certification_catalog
        WHERE id = #{id}
    </select>

    <!-- 관리자용 - 자격증 종류 전체 목록 (이름순) -->
    <select id="findAll" resultType="com.practice.logincrud.certification.catalog.CertificationCatalogDto">
        SELECT id, name, created_at
        FROM certification_catalog
        ORDER BY name ASC
    </select>

    <insert id="insert" parameterType="com.practice.logincrud.certification.catalog.CertificationCatalogDto"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO certification_catalog (name)
        VALUES (#{name})
    </insert>

</mapper>
